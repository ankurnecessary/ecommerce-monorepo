{
  "name": "turborepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "check-types": "turbo run check-types",
    "test:coverage": "turbo run test:coverage",
    "test:ct": "turbo run test:ct",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "precommit:check": "sh scripts/precommit-check.sh"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "turbo": "^2.11.9",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "engines": {
    "node": ">=18"
  }
}
